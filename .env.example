# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real credentials.

# Required: the long id from the sheet URL
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Optional: A1 range to read. Defaults to Wheel!A2:C
# Column A = recommendation, B = recommender, C = weight
GOOGLE_SHEETS_RANGE=Wheel!A2:C

# --- Choose ONE auth option ---

# Option 1: API key (sheet must be shared as "Anyone with the link can view")
GOOGLE_SHEETS_API_KEY=

# Option 2: service account (works with private sheets)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
